# Copy to .env in this directory and fill in real values before running
# `docker compose -f docker-compose.prod.yml up -d --build`.

POSTGRES_DB=spawnpoint
POSTGRES_USER=spawnpoint
POSTGRES_PASSWORD=replace-with-a-real-password

# Use at least 24 random characters (e.g. `openssl rand -hex 24`). A short or
# guessable token is the single admin credential for the whole site.
ADMIN_TOKEN=replace-with-a-long-random-token

# Set to 1 once you terminate TLS in front of the app (e.g. the nginx +
# Cloudflare reverse proxy in docs/nginx-cloudflare-reverse-proxy.md). This
# marks the admin session cookie Secure so it is never sent over plain HTTP.
# Leave empty ONLY while testing over http:// directly.
SECURE_COOKIES=

SERVER_NAME=BF1942 Server
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=14567

# Contact shown on /privacy for takedown/removal requests. A bare email
# renders as mailto:, anything else (URL, form) is used as-is.
PRIVACY_CONTACT=

# Public URL of the site (e.g. https://stats.example.com, no trailing slash).
# Enables social link previews and absolute URLs in /sitemap.xml. Optional.
PUBLIC_BASE_URL=

# Discord webhook for round-complete and server up/down notifications.
# Unset disables both. Optional.
DISCORD_WEBHOOK_URL=

# Host directory containing the BF1942/BFV server's ev_*.xml / .zxml logs;
# mounted read-only into the worker container at /logs.
BF1942_LOG_DIR=./logs

# Host port the web UI is published on.
HTTP_PORT=8080
