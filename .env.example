DATABASE_URL=postgres://spawnpoint:spawnpoint@localhost:5432/spawnpoint?sslmode=disable
PORT=18080
# HOST=127.0.0.1 when running behind a reverse proxy on the same host (see
# docs/nginx-cloudflare-reverse-proxy.md) so the app isn't reachable except
# through it. Leave unset to bind all interfaces (the plain go-run/setup.sh
# default).
ARCHIVE_DIR=/var/lib/spawnpoint/raw-logs
MAX_LOG_FILE_BYTES=104857600
MAX_LOG_EVENTS=5000000
SERVER_NAME=BF1942 Server
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=14567
ADMIN_TOKEN=
# Set to 1 once TLS terminates in front of the app (reverse proxy or
# Cloudflare), so the admin cookie is marked Secure and never sent over plain
# HTTP. See docs/nginx-cloudflare-reverse-proxy.md.
SECURE_COOKIES=
# Overrides where the admin session-signing/CSRF secret is persisted so
# sessions survive restarts. Defaults to data/session.key next to the binary.
# SESSION_KEY_FILE=/var/lib/spawnpoint/session.key
PRIVACY_CONTACT=
DB_MAX_OPEN_CONNS=16
DB_MAX_IDLE_CONNS=8
DB_CONN_MAX_LIFETIME_SECONDS=900
DB_CONN_MAX_IDLE_SECONDS=300
DISCORD_WEBHOOK_URL=
ROUND_NOTIFY_WINDOW=20m
SERVER_WATCH_INTERVAL=60s
PUBLIC_BASE_URL=
HEALTHCHECK_FAIL_THRESHOLD=3
# Per-IP requests/second allowed before throttling (burst is 2x this).
RATE_LIMIT_RPS=20
# How long a rendered page may be served from cache before re-rendering.
PAGE_CACHE_SECONDS=60
# Minutes since the last successful ingest before a server is flagged stale
# on the admin dashboard.
STALE_INGEST_MINUTES=120
